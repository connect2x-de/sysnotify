#include <windows.h>

#define SYSNOTIFY_COMPANY_NAME "connect2x GmbH"
#define SYSNOTIFY_PRODUCT_NAME "Sysnotify COM"
#define SYSNOTIFY_VERSION_MAJOR 1
#define SYSNOTIFY_VERSION_MINOR 0
#define SYSNOTIFY_VERSION_PATCH 0
#define SYSNOTIFY_VERSION_BUILD 0

#define SYSNOTIFY_STRINGIFY_(x) #x
#define SYSNOTIFY_STRINGIFY(x) SYSNOTIFY_STRINGIFY_(x)
#define SYSNOTIFY_TERMINATE(s) s "\0"

#define SYSNOTIFY_VERSION                            \
    SYSNOTIFY_STRINGIFY(SYSNOTIFY_VERSION_MAJOR) "." \
    SYSNOTIFY_STRINGIFY(SYSNOTIFY_VERSION_MINOR) "." \
    SYSNOTIFY_STRINGIFY(SYSNOTIFY_VERSION_PATCH) "." \
    SYSNOTIFY_STRINGIFY(SYSNOTIFY_VERSION_BUILD)

#ifdef SYSNOTIFY_DEBUG
#define SYSNOTIFY_FILE_FLAGS VS_FF_DEBUG
#else
#define SYSNOTIFY_FILE_FLAGS 0
#endif

// https://learn.microsoft.com/en-us/windows/win32/menurc/versioninfo-resource
VS_VERSION_INFO VERSIONINFO
    FILEVERSION SYSNOTIFY_VERSION_MAJOR, SYSNOTIFY_VERSION_MINOR, SYSNOTIFY_VERSION_PATCH, SYSNOTIFY_VERSION_BUILD
    PRODUCTVERSION SYSNOTIFY_VERSION_MAJOR, SYSNOTIFY_VERSION_MINOR, SYSNOTIFY_VERSION_PATCH, SYSNOTIFY_VERSION_BUILD
    FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
    FILEFLAGS SYSNOTIFY_FILE_FLAGS
    FILEOS VOS_NT
    FILETYPE VFT_DLL
    FILESUBTYPE VFT2_UNKNOWN BEGIN
    // https://learn.microsoft.com/en-us/windows/win32/menurc/stringfileinfo-block
    BLOCK "StringFileInfo" BEGIN
        BLOCK "040904b0" BEGIN
            VALUE "CompanyName", SYSNOTIFY_TERMINATE(SYSNOTIFY_COMPANY_NAME)
            VALUE "FileDescription", SYSNOTIFY_TERMINATE("Sysnotify COM bridge module for Windows")
            VALUE "FileVersion", SYSNOTIFY_TERMINATE(SYSNOTIFY_VERSION)
            VALUE "InternalName", SYSNOTIFY_TERMINATE(SYSNOTIFY_PRODUCT_NAME)
            VALUE "LegalCopyright", SYSNOTIFY_TERMINATE("Copyright (C) 2024 " SYSNOTIFY_COMPANY_NAME)
            VALUE "OriginalFilename", SYSNOTIFY_TERMINATE("sysnotify-com.dll")
            VALUE "ProductName", SYSNOTIFY_TERMINATE(SYSNOTIFY_PRODUCT_NAME)
            VALUE "ProductVersion", SYSNOTIFY_TERMINATE(SYSNOTIFY_VERSION)
        END
    END
    // https://learn.microsoft.com/en-us/windows/win32/menurc/varfileinfo-block
    // Consists of any number of WORD,WORD pairs, with each pair describing a language,codepage combination supported by the file.
    BLOCK "VarFileInfo" BEGIN
        VALUE "Translation", 0x409, 0x4B0// We support en_us (0x409) and Unicode (0x4B0)
    END
END