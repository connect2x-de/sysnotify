package = libnotify
headers = libnotify/notify.h

libraryPaths.x64 = libnotify/x64/lib
libraryPaths.arm64 = libnotify/arm64/lib
staticLibraries = libnotify.so

compilerOpts = -Ilibnotify/include -Ilibnotify/include/glib-2.0 -Ilibnotify/include/gdk-pixbuf-2.0
compilerOpts.x64 = -Ilibnotify/x64/include/glib-2.0
compilerOpts.arm64 = -Ilibnotify/arm64/include/glib-2.0
