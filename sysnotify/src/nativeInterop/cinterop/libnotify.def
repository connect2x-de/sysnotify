package = libnotify
headers = libnotify/notify.h

compilerOpts = \
    -Iinclude \
    -Iinclude/glib \
    -Iinclude/gio \
    -Iinclude/gmodule \
    -Iinclude/gobject \
    -Iinclude/girepository \
    -Iinclude/gthread \
    -Iinclude/gdk-pixbuf \
    -Iinclude/libnotify

include = GError, GdkPixbuf, NotifyNotification, NotifyUrgency, gboolean, gint, GBytes, GdkColorspace, GdkColorspace
exclude = *
