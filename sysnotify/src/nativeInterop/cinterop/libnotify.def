package = libnotify
headers = libnotify/notify.h

compilerOpts.x64 = \
    -Ibuild/sysnotify-platform/linuxX64/include \
    -Ibuild/sysnotify-platform/linuxX64/include/glib \
    -Ibuild/sysnotify-platform/linuxX64/include/gio \
    -Ibuild/sysnotify-platform/linuxX64/include/gmodule \
    -Ibuild/sysnotify-platform/linuxX64/include/gobject \
    -Ibuild/sysnotify-platform/linuxX64/include/girepository \
    -Ibuild/sysnotify-platform/linuxX64/include/gthread \
    -Ibuild/sysnotify-platform/linuxX64/include/gdk-pixbuf \
    -Ibuild/sysnotify-platform/linuxX64/include/libnotify

compilerOpts.arm64 = \
    -Ibuild/sysnotify-platform/linuxArm64/include \
    -Ibuild/sysnotify-platform/linuxArm64/include/glib \
    -Ibuild/sysnotify-platform/linuxArm64/include/gio \
    -Ibuild/sysnotify-platform/linuxArm64/include/gmodule \
    -Ibuild/sysnotify-platform/linuxArm64/include/gobject \
    -Ibuild/sysnotify-platform/linuxArm64/include/girepository \
    -Ibuild/sysnotify-platform/linuxArm64/include/gthread \
    -Ibuild/sysnotify-platform/linuxArm64/include/gdk-pixbuf \
    -Ibuild/sysnotify-platform/linuxArm64/include/libnotify

include = GError, GdkPixbuf, NotifyNotification, NotifyUrgency, gboolean, gint, GBytes, GdkColorspace, GdkColorspace
exclude = *
